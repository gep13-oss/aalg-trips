<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>disable</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>
        <UserSecretsId>5966cb71-2501-4cab-a0aa-77b24d37f516</UserSecretsId>
    </PropertyGroup>

    <!-- Stamp the git commit into the assembly's informational version, so the
         site footer can show which revision is live (see BuildInfo). CI passes the
         authoritative value on publish (-p:SourceRevisionId=$GITHUB_SHA); this
         target fills it in from git for a local build. It is a no-op when the value
         was already supplied or when git/the repo is absent (ContinueOnError), and
         must run before the SDK folds the revision into the informational version. -->
    <Target Name="SetGitSourceRevisionId" BeforeTargets="GetAssemblyVersion" Condition="'$(SourceRevisionId)' == ''">
        <Exec Command="git rev-parse HEAD" ConsoleToMSBuild="true" StandardOutputImportance="Low" ContinueOnError="true">
            <Output TaskParameter="ConsoleOutput" PropertyName="SourceRevisionId" />
        </Exec>
    </Target>

    <ItemGroup>
        <!-- The generated UK castle catalogue read by CastleCollection at startup.
             Embedded so it ships in the assembly (deterministic in tests, no
             content-file path to resolve). Regenerate with tools/generate-castles.py. -->
        <EmbeddedResource Include="Data\castles.json" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="SkiaSharp" Version="2.88.9" />
        <!-- The SkiaSharp package only ships Windows/macOS native binaries. This
             brings the Linux libSkiaSharp.so so thumbnail generation works on the
             Linux CI runner and the Linux App Service. The NoDependencies variant
             needs no system fontconfig (we only decode/resize images, no text),
             which suits the minimal App Service host. -->
        <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="2.88.9" />
        <PackageReference Include="Azure.Storage.Blobs" Version="12.29.1" />
    </ItemGroup>

    <ItemGroup>
        <!-- Restores the client-side libraries declared in libman.json (Leaflet)
             into wwwroot/lib on build. Build-time/dev only (PrivateAssets=all);
             keeps the dotnet-only workflow with no npm and nothing to add to the
             Cake pipeline. wwwroot/lib is git-ignored — restored, not committed. -->
        <PackageReference Include="Microsoft.Web.LibraryManager.Build" Version="3.0.67">
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <!--
      Removed in the .NET 10 migration:
        * Microsoft.AspNetCore.All  - 2.1-only metapackage; the framework
          reference is now provided implicitly by Microsoft.NET.Sdk.Web.
        * System.Text.Json          - ships in the shared framework.
      MvcRazorCompileOnPublish / ApplicationInsightsResourceId dropped
      (defaults / not needed for build).

      Removed in the dependency-reduction step:
        * Microsoft.ApplicationInsights.AspNetCore - heavyweight telemetry not
          warranted for a low-traffic family site; the optional startup gate was
          removed with it.
        * WebEssentials.AspNetCore.CdnTagHelpers   - only rewrote asset URLs to an
          Azure edge CDN; assets now serve directly from the app.
        * Slugify.Core                             - replaced by the inline
          Models/SlugHelper, its single use site.
    -->
</Project>
