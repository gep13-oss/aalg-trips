<!DOCTYPE html>
<html lang="en" itemscope itemtype="http://schema.org/WebPage">
<head prefix="og: http://ogp.me/ns#">
    <meta charset="utf-8" />
    <title itemprop="name">@ViewData["Title"] - AALG Trips</title>
    <meta name="description" content="@ViewData["Description"]" />
    <meta name="keywords" content="@ViewData["Title"], photo, picture, gallery, images" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @RenderSection("head", required: false)
    <meta name="application-name" content="@ViewData["Title"]" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="@ViewData["Title"]" />
    <meta property="og:description" content="@ViewData["Description"]" />
    <meta property="og:url" content="@(Context.Request.Scheme + "://" + Context.Request.Host + Context.Request.Path)" />
    <meta property="og:image" content="@ViewData["Image"]" />
    <link rel="shortcut icon" href="~/img/icon16x16.png" />
    <link rel="apple-touch-icon" href="~/img/icon180x180.png" sizes="180x180" />
</head>
<body>
    <header class="site-header">
        <div class="container">
            <a class="wordmark" href="~/" title="Back to the home page" itemprop="name">
                <span class="wordmark__pin" aria-hidden="true"></span>AALG Trips
            </a>
            @{await Html.RenderPartialAsync("_LoginButton.cshtml", ViewData["Title"]);}
        </div>
    </header>

    <main class="container site-main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container">
            <span class="site-footer__mark">AALG Trips</span>
            <span class="site-footer__meta">
                <span class="site-footer__note">A family travel journal</span>
                @if (!string.IsNullOrEmpty(BuildInfo.ShortSha))
                {
                    <a class="site-footer__build" href="@BuildInfo.CommitUrl" title="Built from commit @BuildInfo.CommitSha" target="_blank" rel="noopener noreferrer">@BuildInfo.ShortSha</a>
                }
                else
                {
                    <span class="site-footer__build" title="Local development build">dev</span>
                }
            </span>
        </div>
        <meta itemprop="description" content="@ViewData["Description"]" />
        <meta itemprop="image" content="@ViewData["Image"]" />
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @RenderSection("scripts", required: false)
</body>
</html>
