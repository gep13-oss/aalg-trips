@using System
@using System.Linq
@using AalgTrips.Models
@model Journey
@inject AlbumCollection ac
@{
    // Resolve the journey's linked trips against the album catalogue: the cover is
    // the first linked trip that has a cover photo, and the trip count is how many
    // linked slugs still resolve to an album.
    var linkedAlbums = Model.Stops
        .SelectMany(s => s.Trips ?? Enumerable.Empty<string>())
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .Select(slug => ac.Albums.FirstOrDefault(a => a.Id.Equals(slug, StringComparison.OrdinalIgnoreCase)))
        .Where(a => a != null)
        .ToList();

    var v = Model.Vocabulary;
    var coverAlbum = linkedAlbums.FirstOrDefault(a => a.CoverPhoto != null);
    var stopCount = Model.Waypoints.Count;
    var tripCount = linkedAlbums.Count;
}
<a class="trip-card journey-card" href="@Model.Link">
    <div class="trip-card__media">
        @if (coverAlbum != null)
        {
            <img photo="@coverAlbum.CoverPhoto" type="Cover" />
        }
        else
        {
            <div class="trip-card__placeholder journey-card__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="currentColor" focusable="false">
                    @switch (Model.Kind)
                    {
                        case JourneyKind.Trek:
                            <path d="M14 6l-4.22 5.63 1.25 1.67L14 9.33 19 16h-8.46l-4.01-5.37L1 18h22L14 6z" />
                            break;
                        case JourneyKind.RoadTrip:
                            <path d="M18.92 6.01C18.72 5.42 18.16 5 17.5 5h-11c-.66 0-1.21.42-1.42 1.01L3 12v8c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-1h12v1c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-8l-2.08-5.99zM6.5 16c-.83 0-1.5-.67-1.5-1.5S5.67 13 6.5 13s1.5.67 1.5 1.5S7.33 16 6.5 16zm11 0c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zM5 11l1.5-4.5h11L19 11H5z" />
                            break;
                        default:
                            <path d="M3 15h18l-2 5H5l-2-5Zm9-13 6 3v7H6V5l6-3Zm0 2.2L8 6v4h8V6l-4-1.8Z" />
                            break;
                    }
                </svg>
            </div>
        }
    </div>
    <div class="trip-card__body">
        <h3 class="trip-card__title">@Model.DisplayName</h3>
        <p class="trip-card__dossier">
            <span class="date">@Model.StartDate.ToString("d MMM yyyy").ToUpperInvariant() &ndash; @Model.EndDate.ToString("d MMM yyyy").ToUpperInvariant()</span>
        </p>
        <p class="journey-card__counts">@stopCount @(stopCount == 1 ? v.StopNoun : v.StopNounPlural) · @tripCount trip@(tripCount == 1 ? "" : "s")</p>
        @if (Model.People.Count > 0)
        {
            <p class="trip-card__people"><span class="trip-card__people-label">Who</span> @string.Join(", ", Model.People)</p>
        }
    </div>
</a>