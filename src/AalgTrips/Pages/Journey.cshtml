@page "{name}/{handler?}"
@model JourneysModel
@{
    var journey = Model.Journey;
    var v = journey.Vocabulary;
    var stopHeader = char.ToUpperInvariant(v.StopNoun[0]) + v.StopNoun.Substring(1);
    ViewData["Title"] = journey.DisplayName;
    ViewData["Description"] = $"The {v.Noun} \"{journey.DisplayName}\" — {journey.Stops.Count} stops from {journey.StartDate.ToString("d MMM yyyy")} to {journey.EndDate.ToString("d MMM yyyy")}";

    var inv = System.Globalization.CultureInfo.InvariantCulture;
}

<div id="admin" class="album-admin" if-authorized>
    <details class="actions-menu">
        <summary class="btn btn--ghost actions-menu__trigger">Actions</summary>
        <div class="actions-menu__list">
            <button type="button" class="actions-menu__item" data-open-dialog="#editJourneyDialog">Edit @v.Noun</button>
            <button type="button" class="actions-menu__item" data-open-dialog="#renameJourneyDialog">Rename @v.Noun</button>
            <button type="button" class="actions-menu__item" data-open-dialog="#uploadRouteDialog">Upload route map</button>
            @if (Model.HasRoute)
            {
                <form method="post" class="actions-menu__form">
                    <input type="submit" class="actions-menu__item actions-menu__item--danger" asp-page-handler="deleteroute" id="deleteroute" aria-label="Remove route map" title="Remove route map" value="Remove route map" />
                </form>
            }
            <form method="post" class="actions-menu__form">
                <input type="submit" class="actions-menu__item actions-menu__item--danger" asp-page-handler="delete" id="deletejourney" aria-label="Delete @v.Noun" title="Delete @v.Noun" value="Delete @v.Noun" />
            </form>
        </div>
    </details>

    <dialog id="editJourneyDialog" class="modal modal--wide" aria-label="Edit journey">
        <form class="trip-form modal__form" method="post">
            <h2 class="trip-form__title">Edit @v.Noun</h2>
            <button type="button" class="modal__close" data-close-dialog aria-label="Close">&times;</button>
            <div class="field field--place">
                <label for="journeyName">Name</label>
                <input type="text" name="name" id="journeyName" required value="@journey.DisplayName" />
            </div>
            <div class="field field--kind">
                <label for="journeyKind">Type</label>
                <select name="kind" id="journeyKind">
                    <option value="Cruise" selected="@(journey.Kind == JourneyKind.Cruise)">Cruise</option>
                    <option value="Trek" selected="@(journey.Kind == JourneyKind.Trek)">Trek</option>
                    <option value="RoadTrip" selected="@(journey.Kind == JourneyKind.RoadTrip)">Road trip</option>
                </select>
            </div>
            <div class="field field--date">
                <label for="journeyStart">Departs</label>
                <input type="date" name="startDate" id="journeyStart" required value="@journey.StartDate.ToString("yyyy-MM-dd", inv)" />
            </div>
            <div class="field field--date">
                <label for="journeyEnd">Returns</label>
                <input type="date" name="endDate" id="journeyEnd" required value="@journey.EndDate.ToString("yyyy-MM-dd", inv)" />
            </div>
            <div class="field field--color">
                <label for="journeyColor">Route colour</label>
                <input type="color" name="routeColor" id="journeyColor" value="@journey.RouteColor" />
            </div>
            <div class="field field--notes">
                <label for="journeyDescription">Notes</label>
                <textarea name="description" id="journeyDescription" rows="3">@journey.Description</textarea>
            </div>
            <partial name="_PeopleChecklist" model="journey.People" />
            @{
                var editJourneyItinerary = new ItineraryEditorModel { Stops = journey.Stops, Albums = Model.Albums };
            }
            <partial name="_ItineraryEditor" model="editJourneyItinerary" />
            <div class="field field--actions">
                <button type="button" class="btn btn--ghost" data-close-dialog>Cancel</button>
                <input type="submit" class="btn btn--primary" asp-page-handler="edit" data-progress="Saving…" id="btnEditJourney" value="Save changes" />
            </div>
        </form>
    </dialog>

    <dialog id="renameJourneyDialog" class="modal" aria-label="Rename journey">
        <form class="trip-form modal__form" method="post">
            <h2 class="trip-form__title">Rename @v.Noun</h2>
            <button type="button" class="modal__close" data-close-dialog aria-label="Close">&times;</button>
            <p class="trip-form__hint">Updates the @v.Noun's title <em>and</em> its web address to match; the itinerary and
                linked trips move with it.</p>
            <div class="field field--place">
                <label for="renameJourneyName">New title</label>
                <input type="text" name="name" id="renameJourneyName" required value="@journey.DisplayName" />
            </div>
            <div class="field field--actions">
                <button type="button" class="btn btn--ghost" data-close-dialog>Cancel</button>
                <input type="submit" class="btn btn--primary" asp-page-handler="rename" data-progress="Renaming…" id="btnRenameJourney" value="Rename &amp; fix link" />
            </div>
        </form>
    </dialog>

    <dialog id="uploadStopDialog" class="modal" aria-label="Add photos to a stop">
        <form class="trip-form modal__form" method="post" enctype="multipart/form-data" asp-page-handler="uploadstop">
            <h2 class="trip-form__title">Add photos</h2>
            <button type="button" class="modal__close" data-close-dialog aria-label="Close">&times;</button>
            <input type="hidden" name="stopKey" id="uploadStopKey" />
            <div class="field field--file">
                <label for="stopFiles">Photos from this day</label>
                <input type="file" id="stopFiles" name="files" required multiple accept="image/*" />
            </div>
            <div class="field field--actions">
                <button type="button" class="btn btn--ghost" data-close-dialog>Cancel</button>
                <input type="submit" class="btn btn--primary" data-progress="Uploading…" id="btnStopUpload" value="Upload photos" />
            </div>
        </form>
    </dialog>

    <dialog id="uploadRouteDialog" class="modal" aria-label="Upload a route map">
        <form class="trip-form modal__form" method="post" enctype="multipart/form-data" asp-page-handler="uploadroute">
            <h2 class="trip-form__title">Upload route map</h2>
            <button type="button" class="modal__close" data-close-dialog aria-label="Close">&times;</button>
            <p class="trip-form__hint">A GeoJSON line drawn on the map in place of straight lines between the stops —
                solid for the route travelled, dashed for a travel hop such as a flight. Replaces any route already uploaded.</p>
            <div class="field field--file">
                <label for="routeFile">Route file (GeoJSON)</label>
                <input type="file" id="routeFile" name="file" required accept=".json,.geojson,application/json,application/geo+json" />
            </div>
            <div class="field field--actions">
                <button type="button" class="btn btn--ghost" data-close-dialog>Cancel</button>
                <input type="submit" class="btn btn--primary" data-progress="Uploading…" id="btnRouteUpload" value="Upload route" />
            </div>
        </form>
    </dialog>
</div>

<header class="album-head journey-head">
    <div class="album-head__top">
        <h1 class="album-head__title">@journey.DisplayName</h1>
    </div>
    <p class="album-head__dossier">
        <span>@journey.StartDate.ToString("d MMM yyyy") &ndash; @journey.EndDate.ToString("d MMM yyyy")</span>
        <span class="sep">·</span>
        <span>@journey.Stops.Count stop@(journey.Stops.Count == 1 ? "" : "s")</span>
    </p>
    @if (!string.IsNullOrWhiteSpace(journey.Description))
    {
        <p class="album-head__desc">@journey.Description</p>
    }
    @if (journey.People.Count > 0)
    {
        <p class="album-head__people"><span class="album-head__people-label">Who</span> @string.Join(", ", journey.People)</p>
    }
</header>

@if (journey.Stops.Count > 0)
{
    bool isAdmin = User.IsInRole(Roles.Admin);

    <section class="journey-itinerary" id="gallery">
        <div class="section-head">
            <h2 class="section-head__title">Itinerary</h2>
        </div>
        <div class="itinerary-table-wrap">
            <table class="itinerary-table">
                <thead>
                    <tr>
                        <th scope="col">Date</th>
                        <th scope="col">@stopHeader</th>
                        <th scope="col">Arrive</th>
                        <th scope="col">Depart</th>
                        <th scope="col">Trips</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var stop in journey.Stops)
                    {
                        <tr class="itinerary-row@(stop.AtSea ? " itinerary-row--travel" : "")">
                            <td class="itinerary-date">@stop.Date.ToString("ddd d MMM")</td>
                            <td class="itinerary-stop">
                                @stop.Name
                                @if (stop.AtSea)
                                {
                                    <span class="itinerary-travel-tag">@v.TravelDayLabel.ToLowerInvariant()</span>
                                }
                            </td>
                            <td>@stop.Arrive</td>
                            <td>@stop.Depart</td>
                            <td class="itinerary-trips">
                                @foreach (var slug in stop.Trips ?? new System.Collections.Generic.List<string>())
                                {
                                    var trip = Model.FindTrip(slug);
                                    if (trip != null)
                                    {
                                        <a href="/album/@trip.UrlName/">@trip.DisplayName</a>
                                    }
                                    else
                                    {
                                        <span class="itinerary-trip-missing">@slug</span>
                                    }
                                }
                            </td>
                        </tr>

                        var stopPhotos = Model.StopPhotos(stop.Key);

                        if (!string.IsNullOrWhiteSpace(stop.Key) && (stopPhotos.Count > 0 || isAdmin))
                        {
                            <tr class="itinerary-photos-row" data-stop-photos="@stop.Key">
                                <td colspan="5">
                                    @if (stopPhotos.Count > 0)
                                    {
                                        <div class="stop-photos pic photolist">
                                            @foreach (var photo in stopPhotos)
                                            {
                                                var thumbSrc = photo.GetThumbnailLink((int)ImageType.Thumbnail, out int thumbHeight);

                                                if (thumbSrc == null)
                                                {
                                                    continue;
                                                }

                                                var coverSrc = photo.GetThumbnailLink((int)ImageType.Cover, out int coverHeight);
                                                var fullSrc = photo.GetThumbnailLink((int)ImageType.Full, out int fullHeight);

                                                <figure class="thumb">
                                                    <a href="@(fullSrc ?? photo.PhotoUrl)" data-text="@photo.DisplayName"
                                                       data-pswp-src="@fullSrc" data-pswp-width="@((int)ImageType.Full)" data-pswp-height="@fullHeight">
                                                        <img src="@thumbSrc" srcset="@thumbSrc 1x, @coverSrc 2x" width="@((int)ImageType.Thumbnail)" height="@thumbHeight" alt="@photo.DisplayName" />
                                                    </a>
                                                    <form class="thumb__delete" method="post" asp-page-handler="deletestopphoto" if-authorized>
                                                        <input type="hidden" name="stopKey" value="@stop.Key" />
                                                        <input type="hidden" name="photo" value="@photo.Id" />
                                                        <button type="submit" class="thumb__delete-btn" title="Delete photo" aria-label="Delete @photo.DisplayName">
                                                            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                                                                <polyline points="3 6 5 6 21 6"></polyline>
                                                                <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                                                                <line x1="10" y1="11" x2="10" y2="17"></line>
                                                                <line x1="14" y1="11" x2="14" y2="17"></line>
                                                            </svg>
                                                        </button>
                                                    </form>
                                                </figure>
                                            }
                                        </div>
                                    }
                                    <button type="button" class="btn btn--ghost stop-photos__add" data-upload-stop="@stop.Key" if-authorized>Add photos</button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </section>
}
else
{
    <p class="empty">
        @if (User.IsInRole(Roles.Admin))
        {
            <text>No stops yet — use “Edit @v.Noun” to add the itinerary.</text>
        }
        else
        {
            <text>This @v.Noun has no itinerary yet.</text>
        }
    </p>
}

@if (Model.LinkedTrips.Count > 0)
{
    <section class="trips">
        <div class="section-head">
            <h2 class="section-head__title">Trips on this @v.Noun</h2>
            <span class="section-head__count">@Model.LinkedTrips.Count trip@(Model.LinkedTrips.Count == 1 ? "" : "s")</span>
        </div>
        <div class="trip-grid">
            @foreach (var album in Model.LinkedTrips)
            {
                <partial name="_TripCard" model="album" />
            }
        </div>
    </section>
}

@section head {
    <link rel="stylesheet" href="/lib/photoswipe/photoswipe.css" />
}

@section scripts {
    <script type="module" src="~/js/gallery.js" asp-append-version="true"></script>
    <script if-authorized src="~/js/admin.js" async asp-append-version="true"></script>
    <script if-authorized src="~/js/journey-admin.js" asp-append-version="true"></script>
}