@using System.Collections.Generic
@using AalgTrips.Models
@model ItineraryEditorModel
@{
    var stops = Model.Stops ?? new List<CruiseStop>();
    var albums = Model.Albums ?? new List<Album>();
}
<div class="field field--itinerary">
    <span class="field__legend">Itinerary</span>
    <p class="trip-form__hint">Add a stop for each port or day at sea, in order. The first stop is the
        departure; days at sea have no coordinates and are skipped on the map route.</p>
    <div class="itinerary-editor" data-itinerary>
        <div class="itinerary-rows" data-itinerary-rows>
            @for (var i = 0; i < stops.Count; i++)
            {
                var rowModel = new ItineraryRowModel { Index = i.ToString(), Stop = stops[i], Albums = albums };
                <partial name="_ItineraryRow" model="rowModel" />
            }
        </div>

        @* The template row is inert until cruise-admin.js clones it: its field names
           carry the __INDEX__ placeholder, which the script rewrites to the row's
           position before it is appended to the form. *@
        <template data-stop-template>
            @{
                var templateRow = new ItineraryRowModel { Index = "__INDEX__", Stop = null, Albums = albums };
            }
            <partial name="_ItineraryRow" model="templateRow" />
        </template>

        <button type="button" class="btn btn--ghost" data-add-stop>Add stop</button>
    </div>
</div>