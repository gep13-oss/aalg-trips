{
  "forcessl": false,
  // Admin credentials. Do NOT commit real values here. Set them per
  // environment via user-secrets (development) or environment variables
  // (production), for example:
  //   dotnet user-secrets set "user:username" "<name>"
  //   dotnet user-secrets set "user:salt"     "<salt>"
  //   dotnet user-secrets set "user:password" "<PBKDF2 hash>"
  "user": {
    "username": "",
    "password": "",
    "salt": ""
  },
  // Additional accounts beyond the legacy "user" admin above. The key is the
  // username; each entry has a salt, a PBKDF2 password hash, and a role
  // ("admin" or "viewer" — viewers can browse but not manage content). Use a
  // fresh RANDOM salt for EACH user: salts need not be secret, but they must be
  // unique per account. Do NOT commit real values; set them per environment via
  // user-secrets / App Service settings, for example:
  //   dotnet user-secrets set "Users:alice:salt"     "<unique random salt>"
  //   dotnet user-secrets set "Users:alice:password" "<PBKDF2 hash>"
  //   dotnet user-secrets set "Users:alice:role"     "viewer"
  // See README.md ("Adding a user") for the full step-by-step, including how to
  // generate the salt and the hash.
  "Users": {},
  // Where album content (photos, thumbnails, metadata, markers) is stored.
  // "LocalDisk" (default) keeps content under App_Data/albums (outside the web
  // root) and is used for development and tests. "AzureBlob" stores content in
  // a private Azure Blob container so it survives redeploys. Either way content
  // is served only through the app's authenticated media endpoint, never as a
  // public file. Do NOT commit a real connection string here; set it per
  // environment via user-secrets or environment variables, for example:
  //   dotnet user-secrets set "Storage:AzureBlob:ConnectionString" "<conn>"
  "Storage": {
    "Provider": "LocalDisk",
    "AzureBlob": {
      "ConnectionString": "",
      "ContainerName": "albums"
    }
  },
  // Max total size (in bytes) of an upload request, giving batch photo uploads
  // headroom above Kestrel's 30 MB default (~100 MB here). Raise it per
  // environment if you upload very large batches.
  "Upload": {
    "MaxRequestBodyBytes": 104857600
  },
  // Map basemap. The home/journey map draws CARTO's Voyager raster tiles. CARTO
  // now watermarks unauthenticated ("API KEY REQUIRED") use of its basemaps, so
  // set a (free) CARTO API key here to serve clean tiles. Leave blank to keep the
  // keyless tiles (watermarked). Do NOT commit a real key; set it per environment
  // via user-secrets / App Service settings:
  //   dotnet user-secrets set "Map:CartoApiKey" "<key>"
  "Map": {
    "CartoApiKey": ""
  },
  "Logging": {
    "IncludeScopes": false,
    "Debug": {
      "LogLevel": {
        "Default": "Warning"
      }
    },
    "Console": {
      "LogLevel": {
        "Default": "Warning"
      }
    }
  }
}
